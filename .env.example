# --- AppFlowy MCP configuration -------------------------------------------
# Copy to `.env` and fill in. Do NOT commit `.env`.

# AppFlowy Cloud API base URL.
#   - behind nginx (default self-host):   http://localhost
#   - direct service port (no nginx):     http://localhost:8000
APPFLOWY_BASE_URL=http://localhost

# GoTrue (auth) base URL.
#   - behind nginx:   http://localhost/gotrue
#   - direct port:    http://localhost:9999
APPFLOWY_GOTRUE_URL=http://localhost/gotrue

# Account credentials used to obtain an access token (password grant).
APPFLOWY_EMAIL=you@example.com
APPFLOWY_PASSWORD=your-password

# Optional: default workspace id. If unset, the first workspace from
# GET /api/workspace is used.
# APPFLOWY_WORKSPACE_ID=
